[Unit]
Description=MEC Health Check - daemon de checagem de uptime (1 min)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Ajuste o usuário/grupo e os caminhos conforme o servidor de destino.
User=healthcheck
Group=healthcheck
WorkingDirectory=/opt/health-check
Environment=PYTHONPATH=/opt/health-check/src
# Se o banco final for Oracle, defina a connection string aqui em vez
# de editar config.yaml (evita credenciais no arquivo versionado):
# Environment=HEALTHCHECK_DB_URL=oracle+oracledb://usuario:senha@host:1521/?service_name=ORCLPDB1
ExecStart=/opt/health-check/.venv/bin/python -m healthcheck.daemon --config /opt/health-check/config.yaml
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
