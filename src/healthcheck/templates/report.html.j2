<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Painel de Uptime - Sistemas MEC</title>
<style>
  :root {
    --ok: #16a34a;
    --down: #dc2626;
    --warn: #b45309;
    --bg: #f4f5f7;
    --card-bg: #ffffff;
    --border: #e2e4e9;
    --text: #1f2430;
    --muted: #6b7280;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 24px;
    font-family: -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
  }
  h1 { font-size: 22px; margin: 0 0 4px 0; }
  .subtitle { color: var(--muted); font-size: 13px; margin-bottom: 20px; }
  .method {
    background: #eef2ff;
    border: 1px solid #c7d2fe;
    color: #312e81;
    border-radius: 8px;
    padding: 12px 14px;
    font-size: 12px;
    line-height: 1.5;
    margin-bottom: 20px;
  }
  .card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 20px;
  }
  .target-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 8px;
  }
  .target-name { font-size: 17px; font-weight: 600; }
  .target-url { color: var(--muted); font-size: 12px; word-break: break-all; }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
  }
  .badge.up { background: #dcfce7; color: var(--ok); }
  .badge.down { background: #fee2e2; color: var(--down); }
  .badge.unknown { background: #f1f5f9; color: var(--muted); }
  .badge.blocked { background: #e5e7eb; color: #374151; }
  .badge::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
  }
  .uptime-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
    margin: 16px 0;
  }
  .uptime-stat {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 12px;
  }
  .uptime-stat .label { font-size: 11px; color: var(--muted); text-transform: uppercase; }
  .uptime-stat .value { font-size: 18px; font-weight: 700; margin-top: 2px; }
  .uptime-stat .count { font-size: 11px; color: var(--muted); margin-top: 2px; }
  .uptime-stat .coverage-low { color: var(--warn); font-weight: 600; }
  .sla-box {
    margin: 12px 0;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 13px;
    line-height: 1.5;
  }
  .sla-box.met { background: #dcfce7; color: #14532d; }
  .sla-box.not-met { background: #fee2e2; color: #7f1d1d; }
  .sla-box.unset { background: #f1f5f9; color: var(--muted); }
  .sparkline { margin: 12px 0; }
  .sparkline .label { font-size: 11px; color: var(--muted); margin-bottom: 4px; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; margin-top: 8px; }
  th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--border); }
  th { color: var(--muted); font-weight: 600; font-size: 11px; text-transform: uppercase; }
  .empty { color: var(--muted); font-size: 13px; font-style: italic; }
  .ongoing { color: var(--down); font-weight: 600; }
  .note-accept {
    margin: 10px 0;
    padding: 8px 12px;
    border-radius: 8px;
    background: #fffbeb;
    border: 1px solid #fde68a;
    color: #92400e;
    font-size: 12px;
    line-height: 1.5;
  }
  .table-wrap { overflow-x: auto; }
  .endpoints { margin: 12px 0 4px 0; }
  .endpoints td { vertical-align: top; }
  .endpoints .ep-label { font-weight: 600; }
  .endpoints .ep-url { color: var(--muted); font-size: 11px; word-break: break-all; }
  .ep-ok { color: var(--ok); font-weight: 600; }
  .ep-down { color: var(--down); font-weight: 600; }
  .ep-blocked { color: #374151; font-weight: 600; }
  .note-blocked {
    margin: 10px 0;
    padding: 8px 12px;
    border-radius: 8px;
    background: #f3f4f6;
    border: 1px solid #d1d5db;
    color: #374151;
    font-size: 12px;
    line-height: 1.5;
  }
  .ep-detail { color: var(--muted); font-size: 11px; }
  .rule { color: var(--muted); font-size: 12px; margin: 4px 0 0 0; }
  .culprit { color: var(--down); font-size: 12px; }
  .heatmap-card .card-title { font-size: 17px; font-weight: 600; }
  .heatmap-card .card-subtitle { color: var(--muted); font-size: 12.5px; margin-top: 4px; line-height: 1.5; }
  .heatmap-wrap { margin-top: 12px; }
  .heatmap-note { color: var(--muted); font-size: 11px; margin-top: 4px; }
  .heatmap-legend { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 16px; margin-top: 4px; }
  .heatmap-legend span { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-size: 11px; }
  .heatmap-legend i { width: 12px; height: 12px; border-radius: 3px; display: inline-block; }
  .heatmap-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px 12px; }
  .btn {
    font: inherit; font-size: 12.5px; font-weight: 600; cursor: pointer;
    padding: 6px 12px; border-radius: 8px;
    border: 1px solid var(--border); background: #ffffff; color: var(--text);
  }
  .btn:hover { background: #f8fafc; }
  .btn[aria-pressed="true"] { background: #fffbeb; border-color: #f59e0b; color: #92400e; }
  .sim-banner {
    margin-top: 10px; padding: 8px 12px; border-radius: 8px; font-size: 12px; line-height: 1.5;
    color: #92400e; border: 1px dashed #f59e0b;
    background: repeating-linear-gradient(135deg, #fffbeb, #fffbeb 10px, #fef3c7 10px, #fef3c7 20px);
  }
  .heatmap-card.is-sim { border-color: #f59e0b; }
  .heatmap-fallback { color: var(--muted); font-size: 13px; font-style: italic; padding: 12px 0; }
  footer { color: var(--muted); font-size: 11px; margin-top: 24px; line-height: 1.6; }
</style>
</head>
<body>

<h1>Painel de Uptime / Downtime — Sistemas MEC</h1>
<div class="subtitle">
  Gerado em {{ generated_at | fmt_dt }} ({{ timezone }}) · janela de histórico: {{ lookback_days }} dias
</div>

<div class="method">
  <strong>Como ler estes números.</strong>
  A disponibilidade é medida por amostragem: cada checagem vale pelo intervalo até a
  seguinte, e o uptime % é a proporção de checagens bem sucedidas na janela. Uma falha
  isolada já conta como indisponibilidade (critério acordado, sem tolerância).
  A <strong>cobertura</strong> mostra quantas checagens existem contra quantas eram
  esperadas no período — um trecho sem checagem alguma não é contado como queda, então
  <strong>uptime com cobertura baixa não sustenta glosa</strong>. A cadência informada em
  cada sistema é a <strong>medida nos dados</strong>, não a configurada. O horário de "fim"
  de um incidente é quando a recuperação foi detectada; a amostragem não permite precisar
  o instante exato do retorno.
  Sistemas medidos por <strong>mais de um endpoint</strong> (ex: página inicial + API) só
  contam como no ar numa rodada se <strong>todos</strong> os endpoints responderam OK.
  Quando o <strong>Cloudflare</strong> responde com o desafio anti-bot, a requisição não chega ao
  sistema: a rodada fica <strong>sem medição</strong> (cinza), não conta como no ar nem como fora
  e reduz a cobertura.
</div>

{% for item in systems_data %}
{% set sys = item.system %}
{% set status = item.status %}
{% set multi = item.endpoints | length > 1 %}
<div class="card">
  <div class="target-header">
    <div>
      <div class="target-name">{{ sys.name }}</div>
      {% if not multi %}<div class="target-url">{{ sys.endpoints[0].url }}</div>{% endif %}
    </div>
    {% if item.blocked_since_local %}
      <span class="badge blocked">BLOQUEIO CLOUDFLARE desde {{ item.blocked_since_local | fmt_dt }}</span>
    {% elif status is none %}
      <span class="badge unknown">SEM DADOS</span>
    {% elif status.up %}
      <span class="badge up">ONLINE</span>
    {% else %}
      <span class="badge down">OFFLINE desde {{ item.status_down_since_local | fmt_dt }}</span>
    {% endif %}
  </div>

  {% if item.last_round_local %}
  <div class="target-url">
    Última rodada: {{ item.last_round_local | fmt_dt }}
    {% if not multi %}
      {% set ep = item.endpoints[0] %}
      {% if ep.latest_blocked %} · desafio do Cloudflare (sem medição)
      {% else %}
        {% if ep.latest and ep.latest.status_code %} · HTTP {{ ep.latest.status_code }}{% endif %}
        {% if ep.latest and ep.latest.error %} · {{ ep.latest.error }}{% endif %}
      {% endif %}
    {% elif item.blocked_labels %}
      · bloqueado: {{ item.blocked_labels | join(", ") }}
    {% elif item.down_labels and not status.up %}
      · <span class="culprit">fora: {{ item.down_labels | join(", ") }}</span>
    {% endif %}
    · cadência medida: {{ item.interval_label }}
  </div>
  {% endif %}

  {% if multi %}
  <div class="table-wrap">
  <table class="endpoints">
    <thead>
      <tr>
        <th>Endpoint</th>
        <th>Agora</th>
        <th>Uptime do endpoint no mês</th>
        <th>Aceita como no ar</th>
      </tr>
    </thead>
    <tbody>
      {% for ep in item.endpoints %}
      <tr>
        <td>
          <div class="ep-label">{{ ep.target.label }}</div>
          <div class="ep-url">{{ ep.target.url }}</div>
        </td>
        <td>
          {% if ep.latest is none %}
            <span class="ep-detail">sem dados</span>
          {% elif ep.latest_blocked %}
            <span class="ep-blocked">BLOQUEIO CLOUDFLARE</span>
            <div class="ep-detail">desafio anti-bot, sem medição</div>
          {% else %}
            <span class="{{ 'ep-ok' if ep.latest.success else 'ep-down' }}">{{ "OK" if ep.latest.success else "FALHA" }}</span>
            <div class="ep-detail">
              {% if ep.latest.status_code %}HTTP {{ ep.latest.status_code }}{% endif %}
              {% if ep.latest.error %} · {{ ep.latest.error }}{% endif %}
            </div>
          {% endif %}
        </td>
        <td>{{ ep.month_uptime_pct | fmt_pct }}</td>
        <td>HTTP {{ ep.accepted_label }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  <p class="rule">
    A disponibilidade abaixo é a do <strong>sistema</strong>: numa rodada, ele só conta como no ar se
    <strong>todos</strong> os endpoints acima responderam OK. Basta um cair para o sistema contar como fora.
  </p>
  {% endif %}

  {% for ep in item.endpoints if ep.also_accept %}
  <div class="note-accept">
    Critério ajustado{% if multi %} em <strong>{{ ep.target.label }}</strong>{% endif %}:
    HTTP {{ ep.also_accept | join(", ") }} também conta como "no ar" (config.yaml → also_accept).
  </div>
  {% endfor %}

  {% if item.blocked_rounds_month %}
  <div class="note-blocked">
    <strong>{{ item.blocked_rounds_month }} rodada(s) do mês sem medição</strong>: o Cloudflare respondeu
    com o desafio anti-bot e a requisição do monitor não chegou ao sistema. Essas rodadas não contam
    como no ar nem como fora do ar: ficam fora do uptime, e a cobertura mostra o tamanho da lacuna.
    Para medir de verdade, o MEC precisa liberar o monitor no Cloudflare.
  </div>
  {% endif %}

  <div class="uptime-grid">
    {% for s in item.summaries %}
    <div class="uptime-stat">
      <div class="label">{{ s.label }}</div>
      <div class="value">{{ s.uptime_pct | fmt_pct }}</div>
      <div class="count">{{ s.successful_checks }}/{{ s.total_checks }} {{ "rodadas" if multi else "checagens" }}</div>
      <div class="count{% if s.coverage_pct is not none and s.coverage_pct < min_coverage_pct %} coverage-low{% endif %}">
        cobertura {{ s.coverage_pct | fmt_pct }}
      </div>
    </div>
    {% endfor %}
  </div>

  {% if item.sla_summary %}
    {% set low_coverage = item.month_coverage_pct is not none and item.month_coverage_pct < min_coverage_pct %}
    {% if low_coverage and item.sla_definitely_missed %}
    <div class="sla-box not-met">
      SLA NÃO cumprido no mês corrente, mesmo com cobertura de apenas {{ item.month_coverage_pct | fmt_pct }}:
      o downtime já medido passa da margem que a meta de {{ item.sla_summary.target_pct }}% permite no mês
      inteiro. Cálculo de glosa ainda não implementado — depende da cláusula contratual.
    </div>
    {% elif low_coverage %}
    {# Com pouca cobertura, o percentual não diz se o SLA foi cumprido: um
       "cumprido" sobre 2 checagens seria tão enganoso quanto um descumprido. #}
    <div class="sla-box unset">
      SLA não apurável no mês corrente: uptime de {{ item.sla_summary.actual_pct | fmt_pct }} nas rodadas
      medidas, mas a cobertura é de apenas {{ item.month_coverage_pct | fmt_pct }} — insuficiente para
      afirmar se a meta de {{ item.sla_summary.target_pct }}% foi cumprida ou para embasar glosa.
    </div>
    {% elif item.sla_summary.met %}
    <div class="sla-box met">
      SLA cumprido no mês corrente: {{ item.sla_summary.actual_pct | fmt_pct }} ≥ meta de {{ item.sla_summary.target_pct }}%
    </div>
    {% else %}
    <div class="sla-box not-met">
      SLA NÃO cumprido no mês corrente: {{ item.sla_summary.actual_pct | fmt_pct }} &lt; meta de {{ item.sla_summary.target_pct }}%
      (déficit de {{ "%.2f"|format(item.sla_summary.deficit_pct) }} p.p.).
      Cálculo de glosa ainda não implementado — depende da cláusula contratual.
    </div>
    {% endif %}
  {% elif sla_configured %}
    <div class="sla-box unset">SLA não apurável no mês corrente: nenhuma rodada mediu o sistema.</div>
  {% else %}
    <div class="sla-box unset">Meta de SLA não configurada (config.yaml → sla.target_pct).</div>
  {% endif %}

  {% if item.sparkline %}
  <div class="sparkline">
    <div class="label">Últimas {{ item.sparkline | length }} {{ "rodadas do sistema" if multi else "checagens" }} (mais recente à direita · verde = no ar, vermelho = fora, cinza = bloqueio Cloudflare)</div>
    <svg width="100%" height="24" viewBox="0 0 {{ item.sparkline | length * 7 }} 24" preserveAspectRatio="none">
      {% for state in item.sparkline %}
      <rect x="{{ loop.index0 * 7 }}" y="0" width="5" height="24"
            fill="{{ {'ok': '#16a34a', 'down': '#dc2626', 'blocked': '#9ca3af'}[state] }}" />
      {% endfor %}
    </svg>
  </div>
  {% endif %}

  <div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Incidente (início)</th>
        <th>Recuperação detectada</th>
        {% if multi %}<th>Endpoint(s) com falha</th>{% endif %}
        <th>{{ "Rodadas" if multi else "Checagens" }} com falha</th>
        <th>Downtime contabilizado</th>
      </tr>
    </thead>
    <tbody>
      {% for inc in item.incidents %}
      <tr>
        <td>{{ inc.start | fmt_dt }}</td>
        <td>{% if inc.recovered_at %}{{ inc.recovered_at | fmt_dt }}{% else %}<span class="ongoing">em andamento</span>{% endif %}</td>
        {% if multi %}<td>{{ inc.failed_labels | join(", ") }}</td>{% endif %}
        <td>{{ inc.failed_checks }}</td>
        <td>{{ inc.downtime }}</td>
      </tr>
      {% else %}
      <tr><td colspan="{{ 5 if multi else 4 }}" class="empty">Nenhum incidente registrado na janela.</td></tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
</div>
{% endfor %}

{% set hm = heatmap %}
<div class="card heatmap-card" id="sla-heatmap-card">
  <div class="heatmap-head">
    <div class="card-title" id="sla-heatmap-title">SLA mensal apurado por sistema — {{ hm.year }}</div>
    <button type="button" class="btn" id="sla-heatmap-sim" aria-pressed="false" hidden>Simular ano preenchido</button>
  </div>
  <div class="sim-banner" id="sla-heatmap-banner" hidden>
    <strong>SIMULAÇÃO — dados fictícios.</strong> Só para visualizar o gráfico com o ano preenchido.
    Não representa nenhuma medição e não deve ser usado para apuração de SLA ou glosa.
  </div>
  <div class="card-subtitle">
    Uptime do mês nas rodadas medidas{% if hm.target_pct is not none %}, comparado à meta de {{ hm.target_pct }}%{% endif %}.
    <strong>*</strong> = cobertura abaixo de {{ "%.0f"|format(hm.min_coverage_pct) }}%: o valor não sustenta afirmar
    se a meta foi cumprida. Meses vazios não tiveram monitoramento.
  </div>
  <div class="heatmap-wrap">
    <div id="sla-heatmap" style="height: {{ 50 + hm.systems | length * 30 }}px">
      <div class="heatmap-fallback">Gráfico indisponível: não foi possível carregar echarts.min.js.</div>
    </div>
    <div class="heatmap-legend" id="sla-heatmap-legend"></div>
    <div class="heatmap-note" id="sla-heatmap-note" hidden></div>
  </div>
</div>

<footer>
  Horários em {{ timezone }}. Dados dos últimos {{ lookback_days }} dias (a janela do mês
  corrente é sempre apurada por inteiro, mesmo que ultrapasse esse período).
</footer>

<script src="echarts.min.js"></script>
<script>
(function () {
  var el = document.getElementById('sla-heatmap');
  if (!window.echarts) return;  // fica a mensagem de fallback; o resto do painel é HTML estático
  el.innerHTML = '';

  var H = {{ heatmap | tojson }};
  var STATES = {
    met:            { i: 0, label: 'Meta cumprida',        color: '#16a34a', text: '#ffffff' },
    missed:         { i: 1, label: 'Abaixo da meta',       color: '#dc2626', text: '#ffffff' },
    not_assessable: { i: 2, label: 'Não apurável (cobertura baixa)', color: '#e5e7eb', text: '#374151' },
    blocked:        { i: 3, label: 'Bloqueio Cloudflare',  color: '#9ca3af', text: '#ffffff' },
    measured:       { i: 4, label: 'Medido (sem meta)',    color: '#93c5fd', text: '#1e3a8a' }
  };
  var ORDER = ['met', 'missed', 'not_assessable', 'blocked'].concat(H.target_pct === null ? ['measured'] : []);

  // Legenda em HTML (quebra linha no celular); o visualMap do gráfico fica
  // oculto, mas usa as mesmas cores desta tabela.
  document.getElementById('sla-heatmap-legend').innerHTML = ORDER.map(function (k) {
    return '<span><i style="background:' + STATES[k].color + '"></i>' + STATES[k].label + '</span>';
  }).join('');

  function pct(v) {
    if (v === null) return '-';
    return v >= 99.995 ? '100%' : v.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '%';
  }

  // No celular as 12 colunas não cabem com o rótulo legível: mostra só os
  // últimos meses até o corrente (antes disso, em geral, nem há dados).
  var NARROW_PX = 700, NARROW_MONTHS = 3;
  var note = document.getElementById('sla-heatmap-note');
  var chart = echarts.init(el, null, { renderer: 'svg' });
  var lastMode = null;

  // --- Simulação: preenche o ano com valores fictícios, só para visualizar.
  // Determinística (mesma semente sempre), para o print não mudar a cada clique.
  var simulated = false, SIM = null;
  function mulberry32(a) {
    return function () {
      a |= 0; a = a + 0x6D2B79F5 | 0;
      var t = Math.imul(a ^ a >>> 15, 1 | a);
      t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
      return ((t ^ t >>> 14) >>> 0) / 4294967296;
    };
  }
  function simulatedCells() {
    var rnd = mulberry32(H.year), cells = [], target = H.target_pct === null ? 98 : H.target_pct;
    H.systems.forEach(function (_, y) {
      for (var x = 0; x < 12; x++) {
        var r = rnd(), state, up, cov;
        if (r < 0.04)      { state = 'blocked'; }
        else if (r < 0.10) { state = 'not_assessable'; up = 99 + rnd();          cov = 55 + rnd() * 39; }
        else if (r < 0.19) { state = 'missed';         up = target - 0.3 - rnd() * 3; cov = 98 + rnd() * 2; }
        else               { state = 'met';            up = target + 0.1 + rnd() * (100 - target - 0.1); cov = 97 + rnd() * 3; }
        if (H.target_pct === null && state !== 'blocked' && state !== 'not_assessable') state = 'measured';
        var rounds = 43200, measured = state === 'blocked' ? 0 : Math.round(rounds * cov / 100);
        cells.push({
          x: x, y: y, state: state,
          uptime: state === 'blocked' ? null : Math.min(100, up),
          coverage: state === 'blocked' ? 0 : cov,
          measured: measured,
          failed: state === 'blocked' ? 0 : Math.round(measured * (1 - Math.min(100, up) / 100)),
          blocked: state === 'blocked' ? rounds : 0
        });
      }
    });
    return cells;
  }
  function cells() { return simulated ? (SIM || (SIM = simulatedCells())) : H.cells; }

  var card = document.getElementById('sla-heatmap-card');
  var btn = document.getElementById('sla-heatmap-sim');
  var banner = document.getElementById('sla-heatmap-banner');
  var title = document.getElementById('sla-heatmap-title');
  var realTitle = title.textContent;
  btn.hidden = false;
  btn.addEventListener('click', function () {
    simulated = !simulated;
    btn.setAttribute('aria-pressed', String(simulated));
    btn.textContent = simulated ? 'Voltar aos dados reais' : 'Simular ano preenchido';
    banner.hidden = !simulated;
    card.classList.toggle('is-sim', simulated);
    title.textContent = simulated ? realTitle + ' (SIMULAÇÃO)' : realTitle;
    render(true);
  });

  function render(force) {
    var narrow = el.clientWidth < NARROW_PX;
    if (narrow === lastMode && !force) { chart.resize(); return; }
    lastMode = narrow;
    var first = narrow ? Math.max(0, H.current_month - NARROW_MONTHS + 1) : 0;
    var last = narrow ? H.current_month : 11;
    var months = H.months.slice(first, last + 1);
    var data = [];
    cells().forEach(function (c, idx) {
      if (c.x < first || c.x > last) return;
      var st = STATES[c.state];
      data.push({ value: [c.x - first, c.y, st.i, idx], label: { color: st.text } });
    });
    note.hidden = !narrow;
    note.textContent = narrow ? 'Tela estreita: mostrando ' + months[0] + '–' + months[months.length - 1] + '. Veja o ano inteiro numa tela maior.' : '';
    drawChart(months, first, data, narrow);
  }

  function drawChart(months, first, data, narrow) {
  chart.setOption({
    textStyle: { fontFamily: '-apple-system, "Segoe UI", Roboto, Arial, sans-serif' },
    grid: { left: 8, right: 16, top: 8, bottom: 8, containLabel: true },
    xAxis: {
      type: 'category', data: months, position: 'top',
      axisLine: { show: false }, axisTick: { show: false },
      axisLabel: {
        color: '#6b7280', fontSize: 11, interval: 0,
        formatter: function (m, i) { return i + first === H.current_month ? '{cur|' + m + '}' : m; },
        rich: { cur: { color: '#1f2430', fontWeight: 700, fontSize: 11 } }
      }
    },
    yAxis: {
      type: 'category', data: H.systems, inverse: true,
      axisLine: { show: false }, axisTick: { show: false },
      axisLabel: { color: '#1f2430', fontSize: narrow ? 11 : 12 }
    },
    visualMap: {
      type: 'piecewise', dimension: 2, show: false,
      pieces: ORDER.map(function (k) { return { value: STATES[k].i, label: STATES[k].label, color: STATES[k].color }; })
    },
    tooltip: {
      backgroundColor: '#ffffff', borderColor: '#e2e4e9', textStyle: { color: '#1f2430', fontSize: 12.5 },
      formatter: function (p) {
        var c = cells()[p.data.value[3]];
        var st = STATES[c.state];
        var linhas = [
          simulated ? '<strong style="color:#b45309">SIMULAÇÃO — dado fictício</strong>' : null,
          '<strong>' + H.system_names[c.y] + '</strong>',
          H.months[c.x] + '/' + H.year + ' · ' + st.label
        ];
        if (c.state !== 'blocked') {
          linhas.push('Uptime nas rodadas medidas: <strong>' + pct(c.uptime) + '</strong>');
          linhas.push('Cobertura: ' + pct(c.coverage) + ' · ' + c.measured + ' rodada(s) medida(s), ' + c.failed + ' com falha');
        }
        if (c.blocked) linhas.push(c.blocked + ' rodada(s) sem medição (bloqueio Cloudflare)');
        return linhas.filter(Boolean).join('<br>');
      }
    },
    series: [{
      type: 'heatmap', data: data,
      label: {
        show: true, fontSize: narrow ? 10 : 11, fontWeight: 600,
        formatter: function (p) {
          var c = cells()[p.data.value[3]];
          if (c.state === 'blocked') return 'bloq.';
          return pct(c.uptime) + (c.state === 'not_assessable' ? '*' : '');
        }
      },
      itemStyle: { borderColor: '#ffffff', borderWidth: 2, borderRadius: 3 },
      emphasis: { itemStyle: { borderColor: '#1f2430', borderWidth: 1 } }
    }]
  }, true);
  chart.resize();
  }

  render();
  var t;
  window.addEventListener('resize', function () { clearTimeout(t); t = setTimeout(render, 90); });
})();
</script>
</body>
</html>
